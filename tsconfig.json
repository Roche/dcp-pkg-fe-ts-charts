{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": [
      "node",
      "jest"
    ],
    "lib": [
      "es2017",
      "dom"
    ]
  },
  "include": [
    "src"
  ]
}